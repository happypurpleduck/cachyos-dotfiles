#!/usr/bin/env -S python3 -I
"""Mocha audio effects — the backend behind the control center's AutoEq /
noise-suppression toggles, the Audio effects popup and the F22 mic mute.

  audiofx status                     JSON with everything the shell shows
  audiofx eq on|off|toggle           headphone AutoEq (service mocha-filter@mocha-autoeq)
  audiofx nc on|off|toggle           mic noise suppression (mocha-filter@mocha-micnc)
  audiofx set <key> <value>          strength 0-100 | threshold 0-99 | grace 0-1000 | retro 0-200
                                     applied live (no audio dropout) and saved
  audiofx apply                      regenerate the noise-suppression config from saved settings
  audiofx mute-all [toggle|on|off]   (un)mute every microphone; prints "muted" or "live"

Settings live in ~/.local/state/mocha-shell/audiofx.json. Per-machine hardware
comes from ~/.config/mocha-shell/host.json (dotfiles: hosts/<hostname>):
  audio.autoeq     {"file": "<AutoEq ParametricEQ.txt>", "device": "<short name>"}
                   — absent: no AutoEq on this machine (toggle hidden)
  audio.micDenoise {"source": "<pipewire node.name of the mic>"}
                   — absent: the default microphone at the time it's switched on
"""
import json
import os
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
STATE = HOME / ".local/state/mocha-shell/audiofx.json"
NC_CONF = HOME / ".config/pipewire/mocha-micnc.conf.d/20-mic-rnnoise.conf"
HOST_FILE = HOME / ".config/mocha-shell/host.json"
UNITS = {"eq": "mocha-filter@mocha-autoeq.service", "nc": "mocha-filter@mocha-micnc.service"}
NC_NODE = "capture.mic_rnnoise"

DEFAULTS = {"strength": 100, "threshold": 50, "grace": 200, "retro": 0}
LIMITS = {"strength": (0, 100), "threshold": (0, 99), "grace": (0, 1000), "retro": (0, 200)}


def host():
    try:
        return json.loads(HOST_FILE.read_text()).get("audio", {})
    except (OSError, ValueError):
        return {}


def eq_conf():
    eq = host().get("autoeq") or {}
    return eq if eq.get("file") else None


def mic_name():
    name = (host().get("micDenoise") or {}).get("source")
    if name:
        return name
    cur = run("pactl", "get-default-source").stdout.strip()
    if cur and not cur.startswith("mic_rnnoise"):
        return cur
    srcs = [x["name"] for x in sources() if not x["name"].startswith("mic_rnnoise")]
    return srcs[0] if srcs else ""


def load():
    try:
        data = json.loads(STATE.read_text())
    except (OSError, ValueError):
        data = {}
    return {**DEFAULTS, **{k: v for k, v in data.items() if k in DEFAULTS}}


def save(s):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix(".tmp")
    tmp.write_text(json.dumps(s, indent=2) + "\n")
    os.replace(tmp, STATE)


def run(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True)


def active(key):
    return run("systemctl", "--user", "is-active", UNITS[key]).stdout.strip() == "active"


def set_unit(key, on):
    run("systemctl", "--user", "enable" if on else "disable", "--now", UNITS[key])


def controls(s):
    """RNNoise LADSPA control values for the saved settings."""
    return {
        "VAD Threshold (%)": float(s["threshold"]),
        "VAD Grace Period (ms)": float(s["grace"]),
        "Retroactive VAD Grace (ms)": float(s["retro"]),
        # strength 100% = only the cleaned signal; lower blends the raw mic back in
        "Dry Mix": round(1 - s["strength"] / 100, 3),
    }


def write_nc_conf(s):
    mic = mic_name()
    ctl = "\n".join(f'                            "{k}" = {v}' for k, v in controls(s).items())
    NC_CONF.parent.mkdir(parents=True, exist_ok=True)
    NC_CONF.write_text(f"""# Generated by ~/.config/quickshell/scripts/audiofx from {STATE} — edit there / in the shell.
# RNNoise noise suppression (noise-suppression-for-voice, LADSPA) on {mic}.
# Smart filter: apps recording from that mic (Discord, OBS, browser) get the
# cleaned signal automatically; keep picking the mic as usual.
context.modules = [
    {{   name  = libpipewire-module-filter-chain
        flags = [ nofail ]
        args = {{
            node.description = "Mic Noise Suppression"
            media.name       = "Mic Noise Suppression"
            filter.graph = {{
                nodes = [
                    {{   type   = ladspa
                        name   = rnnoise
                        plugin = /usr/lib/ladspa/librnnoise_ladspa.so
                        label  = noise_suppressor_mono
                        control = {{
{ctl}
                        }}
                    }}
                ]
            }}
            audio.rate     = 48000
            audio.channels = 1
            audio.position = [ MONO ]
            capture.props = {{
                node.name    = "{NC_NODE}"
                node.passive = true
            }}
            playback.props = {{
                node.name   = "mic_rnnoise"
                media.class = Audio/Source
                filter.smart        = true
                filter.smart.name   = "mic-rnnoise"
                filter.smart.target = {{ node.name = "{mic}" }}
            }}
        }}
    }}
]
""")


def node_id(name):
    try:
        for o in json.loads(run("pw-dump").stdout):
            if o.get("info", {}).get("props", {}).get("node.name") == name:
                return str(o["id"])
    except ValueError:
        pass
    return None


def apply_live(s):
    nid = node_id(NC_NODE)
    if not nid:
        return
    params = " ".join(f'"rnnoise:{k}" {v}' for k, v in controls(s).items())
    run("pw-cli", "s", nid, "Props", f"{{ params = [ {params} ] }}")


def eq_profile():
    eq = eq_conf()
    if not eq:
        return ""
    try:
        for line in Path(os.path.expanduser(eq["file"])).read_text().splitlines():
            if line.startswith("# AutoEq"):
                return line.split("—", 1)[-1].strip().split(",")[0]
    except OSError:
        pass
    return "AutoEq"


# ---- microphones ---------------------------------------------------------------
def sources():
    out = run("pactl", "-f", "json", "list", "sources").stdout
    try:
        items = json.loads(out)
    except ValueError:
        return []
    return [s for s in items if s.get("monitor_source") in ("", None) and not s["name"].endswith(".monitor")]


def mute_all(mode):
    srcs = sources()
    if not srcs:
        print("live")
        return
    if mode == "toggle":
        target = any(not s.get("mute") for s in srcs)
    else:
        target = mode == "on"
    for s in srcs:
        run("pactl", "set-source-mute", s["name"], "1" if target else "0")
    print("muted" if target else "live")


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "status"
    s = load()
    if cmd == "status":
        eq = eq_conf()
        print(json.dumps({"eq": bool(eq) and active("eq"), "nc": active("nc"), "eqAvailable": bool(eq),
                          "eqProfile": eq_profile(), "eqDevice": (eq or {}).get("device", ""), **s}))
    elif cmd == "eq" and not eq_conf():
        print("AutoEq isn't set up on this machine (audio.autoeq in host.json)", file=sys.stderr)
        return 1
    elif cmd in ("eq", "nc"):
        mode = argv[2] if len(argv) > 2 else "toggle"
        on = (not active(cmd)) if mode == "toggle" else mode == "on"
        if cmd == "nc":
            write_nc_conf(s)
        set_unit(cmd, on)
        print("on" if on else "off")
    elif cmd == "set":
        key, val = argv[2], float(argv[3])
        lo, hi = LIMITS[key]
        s[key] = int(round(max(lo, min(hi, val))))
        save(s)
        write_nc_conf(s)
        apply_live(s)
    elif cmd == "apply":
        write_nc_conf(s)
    elif cmd == "mute-all":
        mute_all(argv[2] if len(argv) > 2 else "toggle")
    else:
        print(__doc__)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
