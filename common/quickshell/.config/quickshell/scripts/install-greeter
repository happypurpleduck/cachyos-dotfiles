#!/usr/bin/env bash
# Legacy direct installer was unsafe (unconditional rm -rf /etc/greetd assets).
# Keep this compatibility entrypoint non-destructive.
set -euo pipefail
cat >&2 <<'EOF'
The old direct greeter installer is disabled.
Use these reviewed, separate steps from your normal account:
  dot greeter                        # read-only preflight
  dot greeter --stage                # stage verified greeter assets (sudo)
  dot greeter --activate
To replace an existing DM, also pass --replace-display-manager explicitly.
To recover from TTY, run dot greeter --rollback TXID.
EOF
exit 2
