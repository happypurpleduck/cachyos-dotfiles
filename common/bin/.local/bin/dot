#!/usr/bin/env bash
# dot — manage ~/cachyos-dotfiles on this machine. Run `dot help`.
set -euo pipefail

# Resolve the real script, not the cwd or the ~/.local/bin symlink. This makes a
# checkout in any directory usable after bootstrap without exporting DOTFILES.
if [ -n "${DOTFILES:-}" ]; then
  DOT=$DOTFILES
else
  script_path=$(realpath -- "${BASH_SOURCE[0]}")
  checkout=$(realpath -- "$(dirname "$script_path")/../../../..")
  if [ -f "$checkout/install" ] && [ -d "$checkout/common" ]; then
    DOT=$checkout
  else
    DOT=$HOME/cachyos-dotfiles
  fi
fi
DOT=$(realpath -m -- "$DOT")
SYSTEM_HOST=$(cat /etc/hostname 2>/dev/null || hostname)
HOST=${DOT_HOST:-$SYSTEM_HOST}
HOSTDIR=$DOT/hosts/$HOST
BACKUP=$HOME/.local/state/dotfiles-backup/$(date +%Y%m%d-%H%M%S)

# Directories that several packages (or apps) put files into. They're created as
# real directories before stowing so stow links the files inside them instead of
# turning the whole directory into a link into the repo.
SHARED_DIRS=(
  .config .config/hypr .config/pipewire .config/systemd/user .config/autostart
  .local/bin .local/share .local/share/applications .local/state
)

say() { printf '\033[1;35m::\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
die() { printf '\033[1;31m!!\033[0m %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null || die "$1 is not installed (shelly install standard $2)"; }

# Do not allow accidental traversal into a different host directory, and make
# mistakes in DOTFILES fail early instead of touching an unintended checkout.
[ -f "$DOT/install" ] && [ -d "$DOT/common" ] && [ -d "$DOT/hosts" ] || die "not a dotfiles checkout: $DOT"
[[ "$HOST" =~ ^[[:alnum:]][[:alnum:]_.-]*$ ]] || die "invalid hostname: $HOST"
case "$HOST" in .|..|_template) die "cannot activate reserved host: $HOST" ;; esac
if [ "$HOST" != "$SYSTEM_HOST" ]; then
  warn "DOT_HOST selects $HOST (system hostname: $SYSTEM_HOST); using that profile intentionally"
fi

common_pkgs() { (cd "$DOT/common" && for d in */; do echo "${d%/}"; done); }
has_host() { [ -d "$HOSTDIR/home" ]; }

# Read-only precedence preview. Does not stow, link, back up or activate files.
# The linker will consume the same ownership semantics in a follow-up PR.
cmd_plan() {
  need python3 python
  python3 "$DOT/scripts/effective-targets.py" --repo "$DOT" --host "$HOST" --home "$HOME" "$@"
}

# Read-only inventory for a currently running system; no sudo or Stow.
cmd_doctor() {
  need python3 python
  python3 "$DOT/scripts/dot-doctor.py" --repo "$DOT" --host "$HOST" --home "$HOME" "$@"
}

# Every *effective* repo file with its target. This is a single source of
# truth for status, replaced-link checks, and host-safe sync handling.
each_file() {
  python3 "$DOT/scripts/effective-targets.py" --repo "$DOT" --host "$HOST" \
    --home "$HOME" --json |
    python3 -c 'import json,sys; d=json.load(sys.stdin); [print(x["source"]+"\t"+x["target"]) for x in d["entries"]]'
}

# Verify a managed symlink resolves to the effective source.
linked() {
  [ -L "$2" ] || return 1
  local actual expected
  actual=$(realpath -- "$2" 2>/dev/null) || return 1
  expected=$(realpath -- "$1" 2>/dev/null) || return 1
  [ "$actual" = "$expected" ]
}

# Per-file owner-aware transactional linking replaces the unsafe "stow common
# then stow host" overlay. Existing folded Stow directory symlinks must be
# migrated separately; no app directory is flattened implicitly.
cmd_link() {
  need python3 python
  if [ "${1:-}" = "--dry-run" ]; then
    [ "$#" -eq 1 ] || die "usage: dot link [--dry-run|--backup-conflicts]"
    cmd_doctor --strict
    python3 "$DOT/scripts/dot-links.py" --repo "$DOT" --host "$HOST" \
      --home "$HOME" --dry-run
    return
  fi
  # The Python linker includes first-use seeds in the same verified transaction.
  # Keep its exit status even when cmd_link runs inside an if/command substitution.
  python3 "$DOT/scripts/dot-links.py" --repo "$DOT" --host "$HOST" \
    --home "$HOME" "$@"
}

cmd_unlink() {
  need python3 python
  python3 "$DOT/scripts/dot-links.py" --repo "$DOT" --host "$HOST" \
    --home "$HOME" --unlink "$@"
}

cmd_migrate_folded() {
  need python3 python
  python3 "$DOT/scripts/migrate-folded.py" --repo "$DOT" --host "$HOST" \
    --home "$HOME" "$@"
}

cmd_rollback() {
  [ "$#" -eq 1 ] || die "usage: dot rollback <transaction-id>"
  need python3 python
  python3 "$DOT/scripts/dot-links.py" --repo "$DOT" --host "$HOST" \
    --home "$HOME" --rollback "$1"
}

# Some apps save by writing a new file and renaming it over the old one, which
# replaces our link with a plain file (OBS scenes, mimeapps.list after changing a
# default app, …). Copy those back into the repo and relink.
absorb() {
  local src dst n=0
  while IFS=$'\t' read -r src dst; do
    if [ -f "$dst" ] && [ ! -L "$dst" ] && ! linked "$src" "$dst"; then
      cp "$dst" "$src" && rm "$dst" && ln -s "$(realpath --relative-to="$(dirname "$dst")" "$src")" "$dst"
      echo "   took back ~/${dst#"$HOME"/}"
      n=$((n + 1))
    fi
  done < <(each_file)
  return 0
}

cmd_status() {
  local src dst bad=0
  say "repo: $DOT  host: $HOST$(has_host || echo ' (no host dir)')"
  git -C "$DOT" status --short --branch
  while IFS=$'\t' read -r src dst; do
    if linked "$src" "$dst"; then continue; fi
    if [ -f "$dst" ] && [ ! -L "$dst" ]; then
      echo "   replaced by an app (not auto-published): ~/${dst#"$HOME"/}"
    else
      echo "   not linked (dot link): ~/${dst#"$HOME"/}"
    fi
    bad=1
  done < <(each_file)
  if ! python3 "$DOT/scripts/dot-links.py" --repo "$DOT" --host "$HOST" \
      --home "$HOME" --check-retired; then bad=1; fi
  [ $bad -eq 1 ] || echo "   all links ok"
}

# Common files are shared, but a normal save may only publish tracked changes
# in common/ and the currently selected host. Newly added files require explicit
# 'git add'; already staged foreign changes require --allow-staged.
owned_path() {
  case "$1" in
    common/* | "hosts/$HOST/"*) return 0 ;;
    *) return 1 ;;
  esac
}

check_foreign_unstaged() {
  local f bad=0
  while IFS= read -r f; do
    if ! owned_path "$f"; then
      warn "not owned by $HOST: $f (not staged or committed)"
      bad=1
    fi
  done < <(git -C "$DOT" diff --name-only)
  [ "$bad" -eq 0 ] || die "other-host or repository maintenance edits are present; commit them explicitly with git before using dot save"
}

check_staged_scope() {
  local f bad=0
  while IFS= read -r f; do
    if ! owned_path "$f"; then
      warn "already staged outside this host's scope: $f"
      bad=1
    fi
  done < <(git -C "$DOT" diff --cached --name-only)
  [ "$bad" -eq 0 ] || die "use git to unstage these paths, or explicitly run dot save --allow-staged MESSAGE"
}

check_replaced_links() {
  local src dst bad=0
  while IFS=$'\t' read -r src dst; do
    if [ -f "$dst" ] && [ ! -L "$dst" ] && ! linked "$src" "$dst"; then
      warn "app replaced managed link: ~/${dst#"$HOME"/} (source: ${src#"$DOT"/})"
      bad=1
    fi
  done < <(each_file)
  [ "$bad" -eq 0 ] || die "not absorbing app files automatically: inspect and back up the replacements before explicitly copying them to the intended common/ or hosts/$HOST/ source"
}

# dot diff [--stat] [repo paths…] — tracked changes in common + this host,
# plus local app replacements. Untracked files are intentionally excluded:
# a normal dot save will not commit them.
cmd_diff() {
  local stat=() src dst color=never
  [ "${1:-}" = "--stat" ] && { stat=(--stat); shift; }
  [ -t 1 ] && color=always
  local paths=("$@")
  if [ "${#paths[@]}" -eq 0 ]; then
    paths=(common)
    has_host && paths+=("hosts/$HOST")
  fi
  {
    git -C "$DOT" --no-pager diff --color="$color" "${stat[@]}" HEAD -- "${paths[@]}"
    [ $# -eq 0 ] || exit 0
    while IFS=$'\t' read -r src dst; do
      if [ -f "$dst" ] && [ ! -L "$dst" ] && ! linked "$src" "$dst"; then
        printf '\n## app-replaced link (not auto-published): ~/%s\n' "${dst#"$HOME"/}"
        git --no-pager diff --color="$color" "${stat[@]}" --no-index "$src" "$dst" || true
      fi
    done < <(each_file)
  } | if [ -t 1 ]; then less -RFX; else cat; fi
}

cmd_save() {
  local allow_staged=0
  if [ "${1:-}" = "--allow-staged" ]; then
    allow_staged=1
    shift
  fi
  local msg=${*:-"$HOST: update"}

  check_replaced_links
  check_foreign_unstaged
  if [ "$allow_staged" -eq 0 ]; then check_staged_scope; fi

  # add -u never stages untracked files, and never stages other hosts' files.
  git -C "$DOT" add -u -- common
  if has_host; then git -C "$DOT" add -u -- "hosts/$HOST"; fi

  if git -C "$DOT" diff --cached --quiet; then
    say "nothing to commit"
  else
    git -C "$DOT" commit -m "$msg" && say "committed: $msg"
  fi

  # Fetch and stage a read-only preflight before any Git command can mutate
  # linked sources. Remote active/shared changes require explicit dot pull --apply.
  local remote_sha
  remote_sha=$(python3 "$DOT/scripts/pull-preflight.py" --repo "$DOT" \
    --host "$HOST" --home "$HOME" --emit-sha) || {
    warn "saved a local commit but did not rebase or push; review: dot pull"
    warn "after verification, run dot pull --apply and then dot save"
    return 1
  }
  if ! git -C "$DOT" rebase "$remote_sha"; then
    warn "rebase conflicted. Resolve via git rebase --continue or --abort; no force push"
    return 1
  fi
  if ! git -C "$DOT" push; then
    warn "push rejected/failed. Local commit preserved; inspect remote and repeat dot pull"
    return 1
  fi
  say "pushed; new targets require deliberate dot link after reviewing dot doctor"
}

cmd_pull() {
  local consent=() remote_sha
  case "${1:-}" in
    "") [ "$#" -eq 0 ] || die "usage: dot pull [--apply]" ;;
    --apply) [ "$#" -eq 1 ] || die "usage: dot pull [--apply]"; consent=(--apply) ;;
    *) die "usage: dot pull [--apply]" ;;
  esac
  if ! git -C "$DOT" diff --quiet || ! git -C "$DOT" diff --cached --quiet; then
    die "working tree has tracked changes; save/resolve them before remote sync"
  fi
  remote_sha=$(python3 "$DOT/scripts/pull-preflight.py" --repo "$DOT" \
    --host "$HOST" --home "$HOME" --emit-sha "${consent[@]}") || {
      warn "remote preflight blocked sync. Nothing in tracked home config was updated."
      return 1
    }
  if ! git -C "$DOT" rebase "$remote_sha"; then
    warn "rebase stopped. Use git -C \"$DOT\" rebase --continue / --abort."
    return 1
  fi
  say "synced reviewed revision $remote_sha; run dot doctor and dot link as needed"
  warn "existing live symlinks into Git may reflect changes immediately after rebase"
}

pkglist() { grep -v -E '^\s*(#|$)' "$1" 2>/dev/null | awk '{print $1}' || true; }

# ── optional package groups ───────────────────────────────────────────────
# packages/optional/<group>.txt: first line "# description", then packages
# ("aur:<name>" for AUR). Each machine's answers live in hosts/<host>/optional.txt:
# "<group>" = installed here, "!<group>" = declined (not asked again).
OPTDIR=$DOT/packages/optional
opt_groups() { [ -d "$OPTDIR" ] && (cd "$OPTDIR" && for f in *.txt; do [ -e "$f" ] && echo "${f%.txt}"; done) || true; }
opt_desc() { sed -n '1s/^# *//p' "$OPTDIR/$1.txt"; }
opt_chosen() { grep -v -E '^\s*(#|$|!)' "$HOSTDIR/optional.txt" 2>/dev/null | awk '{print $1}' || true; }
opt_state() { # yes | no | (empty = not asked yet)
  grep -qx "$1" "$HOSTDIR/optional.txt" 2>/dev/null && { echo yes; return; }
  grep -qx "!$1" "$HOSTDIR/optional.txt" 2>/dev/null && echo no || true
}
opt_record() { # opt_record <group> yes|no
  local f=$HOSTDIR/optional.txt
  [ -f "$f" ] || printf '# %s — optional package groups (dot optional). "!name" = declined.\n' "$HOST" >"$f"
  sed -i -e "/^!\?$1\$/d" "$f"
  [ "$2" = yes ] && echo "$1" >>"$f" || echo "!$1" >>"$f"
}
# packages of the chosen groups: repo ones, or AUR ones with "aur"
opt_pkgs() {
  local g
  for g in $(opt_chosen); do
    [ -f "$OPTDIR/$g.txt" ] || continue
    if [ "${1:-}" = aur ]; then pkglist "$OPTDIR/$g.txt" | sed -n 's/^aur://p'
    else pkglist "$OPTDIR/$g.txt" | grep -v '^aur:'; fi
  done
}

# dot optional            ask about groups this machine hasn't answered yet
# dot optional --ask      ask about every group again
# dot optional <group>…   install these groups
# dot optional --list     show groups and this machine's answers
cmd_optional() {
  [ -d "$HOSTDIR" ] || die "no hosts/$HOST (dot new-host)"
  local g a st ask_all=0 picked=()
  case ${1:-} in
    --list | -l)
      for g in $(opt_groups); do
        st=$(opt_state "$g"); printf '  %-16s %-10s %s\n' "$g" "${st:-not asked}" "$(opt_desc "$g")"
      done
      return ;;
    --ask) ask_all=1; shift ;;
  esac
  if [ $# -gt 0 ]; then
    for g in "$@"; do [ -f "$OPTDIR/$g.txt" ] || die "no such group: $g (dot optional --list)"; picked+=("$g"); done
  else
    for g in $(opt_groups); do
      st=$(opt_state "$g")
      [ $ask_all -eq 0 ] && [ -n "$st" ] && continue
      read -r -p ":: optional: $(opt_desc "$g") — install? [y/N] " a
      if [[ ${a,,} == y* ]]; then picked+=("$g"); else opt_record "$g" no; fi
    done
  fi
  [ ${#picked[@]} -gt 0 ] || { say "no optional groups to install"; return 0; }
  for g in "${picked[@]}"; do opt_record "$g" yes; done
  cmd_install_packages
}

cmd_packages() {
  need shelly shelly
  [ -d "$HOSTDIR" ] || die "no hosts/$HOST (dot new-host)"
  local desired_repo desired_foreign native_extra foreign_extra explicit_all explicit_aur
  # Inspection is NOT adoption. Existing-machine packages may be historical,
  # vendor self-managed, locally built, or irrelevant to another machine.
  desired_repo=$( (pkglist "$DOT/packages/common.txt";
                   pkglist "$HOSTDIR/packages.txt"; opt_pkgs) | sort -u)
  desired_foreign=$( (pkglist "$DOT/packages/aur.txt";
                      pkglist "$HOSTDIR/aur.txt"; opt_pkgs aur) | sort -u)
  explicit_all=$(shelly list standard --explicitOnly --names-only | sort -u)
  explicit_aur=$(shelly list aur --explicitOnly --names-only | sort -u)
  native_extra=$(comm -23 <(comm -23 <(printf '%s\n' "$explicit_all") <(printf '%s\n' "$explicit_aur")) \
    <(printf '%s\n' "$desired_repo" | sort -u))
  foreign_extra=$(comm -23 <(printf '%s\n' "$explicit_aur") <(printf '%s\n' "$desired_foreign" | sort -u))
  say "read-only installed-package inventory for $HOST (NOT adopted into host manifests)"
  printf '\n:: installed repository packages outside explicit dotfiles requirements:\n%s\n' "$native_extra"
  printf '\n:: installed foreign/local packages outside explicit dotfiles requirements:\n%s\n' "$foreign_extra"
  warn "Review each item before intentionally editing hosts/$HOST/packages.txt or aur.txt."
  warn "Foreign/local packages are NOT automatically approved AUR dependencies."
  if printf '%s\n%s\n' "$native_extra" "$foreign_extra" | grep -Eq '^(mise|zed)$'; then
    warn "mise/Zed already package-managed: migrate manually before using upstream self-update."
  fi
  say "no tracked source files were modified; dot save cannot publish this inventory"
}

cmd_install_packages() {
  need python3 python
  # Declared packages are installed via Shelly without prompts. The package
  # audit still rejects any AUR package outside the reviewed allowlist.
  local missing_aur
  missing_aur=$(python3 "$DOT/scripts/package-audit.py" --repo "$DOT" --host "$HOST" --json |
    python3 -c 'import json,sys; print(" ".join(json.load(sys.stdin)["missing_aur"]))') ||
    die "package audit failed before installation"
  if [ -n "$missing_aur" ]; then
    say "installing declared AUR exceptions via Shelly: $missing_aur"
  fi
  python3 "$DOT/scripts/package-audit.py" --repo "$DOT" --host "$HOST" \
    --install
}

cmd_greeter() {
  need python3 python
  case "${1:-}" in
    --stage | --activate | --install | --rollback)
      sudo python3 "$DOT/scripts/greeter-control.py" --home "$HOME" \
        --source "$HOME/.config/quickshell" --user "$(id -un)" "$@"
      ;;
    *)
      python3 "$DOT/scripts/greeter-control.py" --home "$HOME" \
        --source "$HOME/.config/quickshell" --user "$(id -un)" "$@"
      ;;
  esac
}

# Privileged host services remain explicit; first-party user-local apps are
# bootstrapped as part of the full desktop installation.
cmd_services() {
  need python3 python
  python3 "$DOT/scripts/host-services.py" --repo "$DOT" --host "$HOST" "$@"
}

cmd_apps() {
  need python3 python
  python3 "$DOT/scripts/upstream-apps.py" --home "$HOME" "$@"
}

cmd_assets() {
  need python3 python
  python3 "$DOT/scripts/asset-manager.py" --home "$HOME" "$@"
}

cmd_system_setup() {
  case "${1:-}" in
    "" | --dry-run)
      [ "$#" -le 1 ] || die "usage: dot system-setup [--apply|--dry-run]"
      "$DOT/system/setup" "$@"
      ;;
    --apply)
      [ "$#" -eq 1 ] || die "usage: dot system-setup [--apply]"
      sudo "$DOT/system/setup" --apply
      ;;
    *) die "usage: dot system-setup [--apply]" ;;
  esac
}
# Track only units initially disabled by this install.
INSTALL_NEWLY_ENABLED=()
enable_install_user_unit() {
  local unit=$1
  if systemctl --user is-enabled --quiet "$unit" >/dev/null 2>&1; then return 0; fi
  INSTALL_NEWLY_ENABLED+=("$unit")
  systemctl --user enable "$unit"
}

# If a later pre-login stage fails, undo the links from THIS install only.
# Package-manager transactions and optional asset downloads are not reverted.
install_recover() {
  local txid=$1 failed_phase=$2
  warn "installation stopped during: $failed_phase"
  local i unit
  for ((i=${#INSTALL_NEWLY_ENABLED[@]}-1; i>=0; i--)); do
    unit=${INSTALL_NEWLY_ENABLED[i]}
    if systemctl --user is-enabled --quiet "$unit" >/dev/null 2>&1; then
      if systemctl --user disable "$unit"; then
        warn "restored initially disabled user unit: $unit"
      else
        warn "FAILED to restore user unit $unit; disable it manually before reboot"
      fi
    fi
  done
  if [ -n "$txid" ]; then
    if python3 "$DOT/scripts/dot-links.py" --repo "$DOT" --host "$HOST" \
      --home "$HOME" --rollback "$txid"; then
      warn "managed link changes restored; previous HOME files remain in backup"
    else
      warn "automatic link rollback failed; inspect journal for $txid before proceeding"
    fi
  fi
  warn "installed packages, optional downloads and self-managed apps are NOT automatically removed"
  warn "if --apply-system was used, restore PAM from its root-owned backup as instructed"
  return 1
}

# Installation has explicit preflight and failure boundaries. It never runs
# arbitrary host scripts; required Mocha greetd activation uses a separate
# root-owned rollback journal and does not disturb the running session.
cmd_install() {
  if [ "${1:-}" = "--dry-run" ]; then
    [ "$#" -eq 1 ] || die "usage: dot install [--dry-run|--apply-system]"
    # Preview the same backup-aware policy as a regular install, without
    # creating any file, backup, or package transaction.
    python3 "$DOT/scripts/package-audit.py" --repo "$DOT" --host "$HOST" ||
      die "package prerequisites unavailable"
    local preview_status=0
    local -a preview_args=()
    if python3 "$DOT/scripts/dot-links.py" --repo "$DOT" --host "$HOST" --home "$HOME" --install-preflight; then
      preview_args=()
    else
      preview_status=$?
      [ "$preview_status" -eq 3 ] ||
        die "unsafe home configuration targets; inspect dot doctor"
      preview_args=(--backup-conflicts)
    fi
    python3 "$DOT/scripts/dot-links.py" --repo "$DOT" --host "$HOST" --home "$HOME" "${preview_args[@]}" --dry-run || return
    say "upstream applications (read-only status; installed if missing during apply)"
    python3 "$DOT/scripts/upstream-apps.py" --home "$HOME" status
    say "Mocha greeter will be staged and enabled for next boot (existing DM backed up)"
    return
  fi
  local apply_system=0 a link_output link_txid="" link_preflight_status=0
  local -a link_args=()
  INSTALL_NEWLY_ENABLED=()
  if [ "${1:-}" = "--apply-system" ]; then
    [ "$#" -eq 1 ] || die "usage: dot install [--dry-run|--apply-system]"
    apply_system=1
  elif [ "$#" -ne 0 ]; then
    die "usage: dot install [--dry-run|--apply-system]"
  fi
  [ -d "$HOSTDIR/home" ] || die "create hosts/$HOST first with dot new-host"
  # Optional groups are chosen with dot optional, not polled on each install.
  python3 "$DOT/scripts/package-audit.py" --repo "$DOT" --host "$HOST" ||
    die "package prerequisites unavailable"
  # This is a declarative installer: existing files at managed targets are
  # replaced by repository links. Save exact originals in the same journal
  # automatically. Unsafe parent paths and cross-host links remain blockers.
  if python3 "$DOT/scripts/dot-links.py" --repo "$DOT" --host "$HOST" --home "$HOME" --install-preflight; then
    link_args=()
  else
    link_preflight_status=$?
    case "$link_preflight_status" in
      3)
        say "existing configs will be replaced with managed links (originals backed up automatically)"
        say "backup location: ~/.local/state/dotfiles-backup/transactions/"
        link_args=(--backup-conflicts)
        ;;
      *) die "unsafe home configuration targets; inspect dot doctor before installing" ;;
    esac
  fi
  # Recheck the plan under the selected backup policy before package installation.
  if ! python3 "$DOT/scripts/dot-links.py" --repo "$DOT" --host "$HOST" --home "$HOME" "${link_args[@]}" --dry-run >/dev/null; then
    die "link plan changed or contains unsafe targets; no packages installed"
  fi
  cmd_install_packages
  say "attempting optional assets (independent of core config)"
  "$DOT/scripts/fetch-assets" || warn "optional asset downloader failed; solid wallpaper fallback remains"
  # Fail BEFORE linking if the user manager or required notifier is missing.
  if ! systemctl --user daemon-reload; then
    die "user systemd manager unavailable; log into a user session before install"
  fi
  if ! systemctl --user cat hokum.service >/dev/null 2>&1; then
    die "required hokum.service unit missing after installing prerequisites"
  fi
  if ! link_output=$(cmd_link "${link_args[@]}"); then
    die "managed link transaction failed; inspect its rollback journal"
  fi
  printf "%s\n" "$link_output"
  link_txid=$(printf "%s\n" "$link_output" | awk '/rollback with: dot rollback / {print $NF}' | tail -n1)
  say "generating essential first-login themes offline"
  if ! python3 "$DOT/scripts/first-login.py" --home "$HOME"; then
    install_recover "$link_txid" "offline theme generation"
    return 1
  fi
  if ! fc-cache -f >/dev/null; then
    install_recover "$link_txid" "font cache"
    return 1
  fi
  if ! enable_install_user_unit hokum.service; then
    install_recover "$link_txid" "Hokum user service enablement"
    return 1
  fi
  if systemctl --user cat gnome-keyring-daemon.socket >/dev/null 2>&1; then
    enable_install_user_unit gnome-keyring-daemon.socket ||
      warn "optional keyring socket could not be enabled"
  else
    warn "optional gnome-keyring-daemon.socket unavailable"
  fi
  say "host-selected SYSTEM services (read-only; opt-in separately)"
  python3 "$DOT/scripts/host-services.py" --repo "$DOT" --host "$HOST" ||
    warn "host system services need attention; use dot services --apply"
  if [ "$apply_system" -eq 1 ]; then
    say "explicitly applying limited PAM/DDC setup (sudo)"
    if ! sudo "$DOT/system/setup" --apply; then
      install_recover "$link_txid" "limited PAM/DDC system integration"
      return 1
    fi
  else
    say "optional PAM/DDC integration unchanged; Mocha greeter handled separately"
  fi
  # Never run an arbitrary host-specific setup script during routine install.
  if [ -x "$HOSTDIR/setup" ]; then
    warn "host-specific setup remains unapplied; review with dot host-setup"
  fi
  if command -v zsh >/dev/null &&
     [ "$(getent passwd "$(id -un)" | cut -d: -f7)" != "$(command -v zsh)" ]; then
    say "setting the declared default Zsh login shell"
    sudo chsh -s "$(command -v zsh)" "$(id -un)" ||
      warn "shell change failed; adjust manually with chsh"
  fi
  if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    "$HOME/.config/quickshell/scripts/mocha-theme" restore ||
      warn "active wallpaper refresh failed; generated theme files remain"
  fi
  say "installing missing first-party self-managed apps (mise, Zed)"
  if ! python3 "$DOT/scripts/upstream-apps.py" --home "$HOME" install mise zed; then
    install_recover "$link_txid" "self-managed application bootstrap"
    return 1
  fi
  # Installing the complete desktop includes its login manager. The separate
  # greeter journal preserves the old DM/config; never interrupt this session.
  say "staging and enabling Mocha greeter for next boot"
  if ! sudo python3 "$DOT/scripts/greeter-control.py" --home "$HOME" \
      --source "$HOME/.config/quickshell" --user "$(id -un)" --install; then
    install_recover "$link_txid" "Mocha greeter staging/activation"
    return 1
  fi
  say "install complete: managed links, upstream apps and Mocha greeter ready (next boot)"
  say "recovery link transaction: ${link_txid:-none (no changes)}"
}

# Host-specific executable setup scripts are previewed unless --apply is given.
cmd_host_setup() {
  [ -x "$HOSTDIR/setup" ] || { say "no host setup script selected"; return 0; }
  say "host setup script: $HOSTDIR/setup"
  if [ "${1:-}" != "--apply" ]; then
    say "PREVIEW ONLY; inspect its source, then dot host-setup --apply"
    return 0
  fi
  [ "$#" -eq 1 ] || die "usage: dot host-setup [--apply]"
  "$HOSTDIR/setup"
}

cmd_new_host() {
  [ "$#" -le 1 ] || die "usage: dot new-host [name]"
  local name=${1:-$HOST}
  [[ "$name" =~ ^[[:alnum:]][[:alnum:]_.-]*$ ]] ||
    die "invalid hostname: $name"
  case "$name" in .|..|_template) die "cannot create reserved host: $name" ;; esac
  { [ -e "$DOT/hosts/$name" ] || [ -L "$DOT/hosts/$name" ]; } && die "hosts/$name already exists"
  cp -r "$DOT/hosts/_template" "$DOT/hosts/$name"
  sed -i "s/HOSTNAME/$name/g" "$DOT/hosts/$name/README.md" "$DOT/hosts/$name/home/.config/hypr/host.lua"
  say "created hosts/$name — review its host.lua and host.json, then run ./install to activate"
}

# dot add [--host] <path>… — preview and copy files; never move HOME files.
#   common package = first directory under ~/.config (or the file name for dotfiles in ~)
# Safe import: preview by default; a copy does not publish or relink.
cmd_add() {
  need python3 python
  local args=() arg
  for arg in "$@"; do
    if [ "$arg" = "--host" ]; then
      args+=(--host-only)
    else
      args+=("$arg")
    fi
  done
  python3 "$DOT/scripts/import-config.py" --repo "$DOT" --home "$HOME" \
    --host "$HOST" "${args[@]}"
}

cmd_help() {
  cat <<EOF
dot — $DOT on $HOST

  dot install          reconcile declared desktop without repeated approvals
  dot install --apply-system  explicitly include limited PAM/DDC system setup
  dot system-setup [--apply]  preview or apply limited PAM/DDC setup
  dot greeter [--stage|--install|--activate|--rollback TXID]  safe login-manager control
  dot host-setup [--apply]    preview or run this host's setup script
  dot services                read-only host system service status
  dot services --apply        enable/start this host's selected system services
  dot apps status             first-party mise/Zed install type and update policy
  dot apps install mise zed   explicit vendor installer bootstraps (no Shelly/AUR)
  dot apps update mise        use mise self-update; Zed updates on restart
  dot assets --status          inspect optional downloads without network
  dot assets --asset t3code    fetch one optional asset (use --force to refresh)
  dot link             safely link this host's effective per-file configuration
  dot link --backup-conflicts  back up colliding home files before linking
  dot unlink           unlink managed files without deleting app data
  dot rollback TXID    restore links/files from an applied transaction
  dot migrate-folded [--apply]  preview or explicitly migrate legacy Stow dir links
  dot status           git status + links that are missing or were replaced by an app
  dot plan [--json]    read-only effective common/host target precedence
  dot doctor [--json|--strict]   preflight links, packages, display-manager status
  dot install --dry-run          preview only; does not install or activate
  dot link --dry-run             preview only; does not touch HOME
  dot diff [--stat] [path…]  tracked shared/host changes; ignores untracked files
  dot save [message]   commit tracked shared/host edits, rebase and push
  dot save --allow-staged MSG  also publish explicitly staged other-host/maintenance files
  dot pull             preview remote active changes; sync other-host-only edits
  dot pull --apply     apply a reviewed preflight-passing remote revision
  dot add [--host] F…  preview safe app config copy (never moves HOME)
  dot add --apply [--host] F…  copy reviewed config; link and stage separately
  dot packages         inspect installed extras; manually choose managed host packages
  dot optional [grp…]  optional apps: ask about new groups, or install the named ones
                       (--list shows them, --ask asks about all of them again)
  dot new-host [name]  start hosts/<name> from hosts/_template
  dot cd               print the repo path (cd "\$(dot cd)")
EOF
}

case ${1:-help} in
  install) shift; cmd_install "$@" ;;
  system-setup) shift; cmd_system_setup "$@" ;;
  assets) shift; cmd_assets "$@" ;;
  apps) shift; cmd_apps "$@" ;;
  services) shift; cmd_services "$@" ;;
  host-setup) shift; cmd_host_setup "$@" ;;
  greeter) shift; cmd_greeter "$@" ;;
  link) shift; cmd_link "$@" ;;
  unlink) shift; cmd_unlink "$@" ;;
  rollback) shift; cmd_rollback "$@" ;;
  migrate-folded) shift; cmd_migrate_folded "$@" ;;
  status | st) cmd_status ;;
  plan) shift; cmd_plan "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  diff | d) shift; cmd_diff "$@" ;;
  save) shift; cmd_save "$@" ;;
  pull | sync) shift; cmd_pull "$@" ;;
  add) shift; cmd_add "$@" ;;
  packages | pkgs) cmd_packages ;;
  install-packages) cmd_install_packages ;;
  optional | opt) shift; cmd_optional "$@" ;;
  new-host) shift; cmd_new_host "${1:-}" ;;
  cd | path) echo "$DOT" ;;
  help | -h | --help) cmd_help ;;
  *) cmd_help; exit 1 ;;
esac
