#!/usr/bin/env bash
# dot — manage ~/cachyos-dotfiles on this machine. Run `dot help`.
set -euo pipefail

# Resolve the real script, not the cwd or the ~/.local/bin symlink. This makes a
# checkout in any directory usable after bootstrap without exporting DOTFILES.
if [ -n "${DOTFILES:-}" ]; then
  DOT=$DOTFILES
else
  script_path=$(realpath -- "${BASH_SOURCE[0]}")
  checkout=$(realpath -- "$(dirname "$script_path")/../../../..")
  if [ -f "$checkout/install" ] && [ -d "$checkout/common" ]; then
    DOT=$checkout
  else
    DOT=$HOME/cachyos-dotfiles
  fi
fi
DOT=$(realpath -m -- "$DOT")
SYSTEM_HOST=$(cat /etc/hostname 2>/dev/null || hostname)
HOST=${DOT_HOST:-$SYSTEM_HOST}
HOSTDIR=$DOT/hosts/$HOST
BACKUP=$HOME/.local/state/dotfiles-backup/$(date +%Y%m%d-%H%M%S)

# Directories that several packages (or apps) put files into. They're created as
# real directories before stowing so stow links the files inside them instead of
# turning the whole directory into a link into the repo.
SHARED_DIRS=(
  .config .config/hypr .config/pipewire .config/systemd/user .config/autostart
  .local/bin .local/share .local/share/applications .local/state
)

say() { printf '\033[1;35m::\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
die() { printf '\033[1;31m!!\033[0m %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null || die "$1 is not installed (sudo pacman -S $2)"; }

# Do not allow accidental traversal into a different host directory, and make
# mistakes in DOTFILES fail early instead of touching an unintended checkout.
[ -f "$DOT/install" ] && [ -d "$DOT/common" ] && [ -d "$DOT/hosts" ] || die "not a dotfiles checkout: $DOT"
[[ "$HOST" =~ ^[[:alnum:]][[:alnum:]_.-]*$ ]] || die "invalid hostname: $HOST"
case "$HOST" in .|..|_template) die "cannot activate reserved host: $HOST" ;; esac
if [ "$HOST" != "$SYSTEM_HOST" ]; then
  warn "DOT_HOST selects $HOST (system hostname: $SYSTEM_HOST); using that profile intentionally"
fi

common_pkgs() { (cd "$DOT/common" && for d in */; do echo "${d%/}"; done); }
has_host() { [ -d "$HOSTDIR/home" ]; }

# every repo file with its target: "<source>\t<target>"
each_file() {
  local pkg
  for pkg in $(common_pkgs); do
    (cd "$DOT/common/$pkg" && find . \( -type f -o -type l \) ! -name .gitignore) | sed 's|^\./||' |
      while read -r f; do printf '%s\t%s\n' "$DOT/common/$pkg/$f" "$HOME/$f"; done
  done
  if has_host; then
    (cd "$HOSTDIR/home" && find . \( -type f -o -type l \) ! -name .gitignore) | sed 's|^\./||' |
      while read -r f; do printf '%s\t%s\n' "$HOSTDIR/home/$f" "$HOME/$f"; done
  fi
}

linked() { [ "$(readlink -f "$2" 2>/dev/null)" = "$(readlink -f "$1")" ]; }

# Move files that would block stow (real files where a link should go) to $BACKUP.
backup_conflicts() {
  local src dst n=0
  while IFS=$'\t' read -r src dst; do
    if [ -e "$dst" ] || [ -L "$dst" ]; then
      linked "$src" "$dst" && continue
      mkdir -p "$BACKUP/$(dirname "${dst#"$HOME"/}")"
      mv "$dst" "$BACKUP/${dst#"$HOME"/}"
      # drop directories this leaves empty, so stow can link the whole directory
      rmdir -p --ignore-fail-on-non-empty "$(dirname "$dst")" 2>/dev/null || true
      n=$((n + 1))
    fi
  done < <(each_file)
  [ $n -eq 0 ] || warn "moved $n existing file(s) out of the way → $BACKUP"
}

cmd_link() {
  need stow stow
  local d
  backup_conflicts
  for d in "${SHARED_DIRS[@]}"; do mkdir -p "$HOME/$d"; done
  say "linking common: $(common_pkgs | tr '\n' ' ')"
  # shellcheck disable=SC2046
  stow -d "$DOT/common" -t "$HOME" --restow $(common_pkgs)
  if has_host; then
    say "linking hosts/$HOST"
    # host files are linked one by one, never as whole directories, so app data
    # next to them (OBS logs, stream keys, …) can't end up in the repo
    stow -d "$HOSTDIR" -t "$HOME" --no-folding --restow home
  else
    warn "no hosts/$HOST yet — only the shared config is linked. Create it with: dot new-host"
  fi
  seed
  # Hyprland doesn't notice edits made through the symlinks; reload it ourselves
  if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && command -v hyprctl >/dev/null; then
    hyprctl reload >/dev/null && echo "   reloaded Hyprland"
  fi
}

# seed/: configs apps rewrite all the time (btop, waypaper, zed). Copied once, never linked.
seed() {
  [ -d "$DOT/seed" ] || return 0
  (cd "$DOT/seed" && find . -type f) | sed 's|^\./||' | while read -r f; do
    if [ ! -e "$HOME/$f" ]; then
      mkdir -p "$HOME/$(dirname "$f")"
      cp "$DOT/seed/$f" "$HOME/$f"
      echo "   seeded ~/$f"
    fi
  done
}

cmd_unlink() {
  need stow stow
  # shellcheck disable=SC2046
  stow -d "$DOT/common" -t "$HOME" -D $(common_pkgs)
  if has_host; then stow -d "$HOSTDIR" -t "$HOME" -D home; fi
  say "unlinked (your files in the repo are untouched)"
}

# Some apps save by writing a new file and renaming it over the old one, which
# replaces our link with a plain file (OBS scenes, mimeapps.list after changing a
# default app, …). Copy those back into the repo and relink.
absorb() {
  local src dst n=0
  while IFS=$'\t' read -r src dst; do
    if [ -f "$dst" ] && [ ! -L "$dst" ] && ! linked "$src" "$dst"; then
      cp "$dst" "$src" && rm "$dst" && ln -s "$(realpath --relative-to="$(dirname "$dst")" "$src")" "$dst"
      echo "   took back ~/${dst#"$HOME"/}"
      n=$((n + 1))
    fi
  done < <(each_file)
  return 0
}

cmd_status() {
  local src dst bad=0
  say "repo: $DOT  host: $HOST$(has_host || echo ' (no host dir)')"
  git -C "$DOT" status --short --branch
  while IFS=$'\t' read -r src dst; do
    if linked "$src" "$dst"; then continue; fi
    if [ -f "$dst" ] && [ ! -L "$dst" ]; then
      echo "   replaced by an app (not auto-published): ~/${dst#"$HOME"/}"
    else
      echo "   not linked (dot link): ~/${dst#"$HOME"/}"
    fi
    bad=1
  done < <(each_file)
  [ $bad -eq 1 ] || echo "   all links ok"
}

# Common files are shared, but a normal save may only publish tracked changes
# in common/ and the currently selected host. Newly added files require explicit
# 'git add'; already staged foreign changes require --allow-staged.
owned_path() {
  case "$1" in
    common/* | "hosts/$HOST/"*) return 0 ;;
    *) return 1 ;;
  esac
}

check_foreign_unstaged() {
  local f bad=0
  while IFS= read -r f; do
    if ! owned_path "$f"; then
      warn "not owned by $HOST: $f (not staged or committed)"
      bad=1
    fi
  done < <(git -C "$DOT" diff --name-only)
  [ "$bad" -eq 0 ] || die "other-host or repository maintenance edits are present; commit them explicitly with git before using dot save"
}

check_staged_scope() {
  local f bad=0
  while IFS= read -r f; do
    if ! owned_path "$f"; then
      warn "already staged outside this host's scope: $f"
      bad=1
    fi
  done < <(git -C "$DOT" diff --cached --name-only)
  [ "$bad" -eq 0 ] || die "use git to unstage these paths, or explicitly run dot save --allow-staged MESSAGE"
}

check_replaced_links() {
  local src dst bad=0
  while IFS=$'\t' read -r src dst; do
    if [ -f "$dst" ] && [ ! -L "$dst" ] && ! linked "$src" "$dst"; then
      warn "app replaced managed link: ~/${dst#"$HOME"/} (source: ${src#"$DOT"/})"
      bad=1
    fi
  done < <(each_file)
  [ "$bad" -eq 0 ] || die "not absorbing app files automatically: inspect and back up the replacements before explicitly copying them to the intended common/ or hosts/$HOST/ source"
}

# dot diff [--stat] [repo paths…] — tracked changes in common + this host,
# plus local app replacements. Untracked files are intentionally excluded:
# a normal dot save will not commit them.
cmd_diff() {
  local stat=() src dst color=never
  [ "${1:-}" = "--stat" ] && { stat=(--stat); shift; }
  [ -t 1 ] && color=always
  local paths=("$@")
  if [ "${#paths[@]}" -eq 0 ]; then
    paths=(common)
    has_host && paths+=("hosts/$HOST")
  fi
  {
    git -C "$DOT" --no-pager diff --color="$color" "${stat[@]}" HEAD -- "${paths[@]}"
    [ $# -eq 0 ] || exit 0
    while IFS=$'\t' read -r src dst; do
      if [ -f "$dst" ] && [ ! -L "$dst" ] && ! linked "$src" "$dst"; then
        printf '\n## app-replaced link (not auto-published): ~/%s\n' "${dst#"$HOME"/}"
        git --no-pager diff --color="$color" "${stat[@]}" --no-index "$src" "$dst" || true
      fi
    done < <(each_file)
  } | if [ -t 1 ]; then less -RFX; else cat; fi
}

cmd_save() {
  local allow_staged=0
  if [ "${1:-}" = "--allow-staged" ]; then
    allow_staged=1
    shift
  fi
  local msg=${*:-"$HOST: update"}

  check_replaced_links
  check_foreign_unstaged
  if [ "$allow_staged" -eq 0 ]; then check_staged_scope; fi

  # add -u never stages untracked files, and never stages other hosts' files.
  git -C "$DOT" add -u -- common
  if has_host; then git -C "$DOT" add -u -- "hosts/$HOST"; fi

  if git -C "$DOT" diff --cached --quiet; then
    say "nothing to commit"
  else
    git -C "$DOT" commit -m "$msg" && say "committed: $msg"
  fi

  # Rebase only after a local commit; no autostash or force push.
  if ! git -C "$DOT" pull --rebase; then
    warn "sync stopped. Resolve conflicts with 'git -C "$DOT" rebase --continue',"
    warn "or preserve your work and abort with 'git -C "$DOT" rebase --abort'. Nothing was force-pushed."
    return 1
  fi
  git -C "$DOT" push
  say "pushed; new files are not automatically linked (run dot link after checking host prerequisites)"
}

cmd_pull() {
  if ! git -C "$DOT" diff --quiet || ! git -C "$DOT" diff --cached --quiet; then
    die "working tree contains tracked edits; review or save them before dot pull (no automatic stash)"
  fi
  if ! git -C "$DOT" pull --rebase; then
    warn "pull stopped: resolve with 'git -C "$DOT" rebase --continue' or --abort"
    return 1
  fi
  # This does not apply new links or run setup; linked *existing* files still
  # track the repo and may change when Git updates them. Full activation gates
  # and rollback are tracked separately in #6.
  say "repository updated; review changes and prerequisites before running dot link"
}

pkglist() { grep -v -E '^\s*(#|$)' "$1" 2>/dev/null | awk '{print $1}' || true; }

# ── optional package groups ───────────────────────────────────────────────
# packages/optional/<group>.txt: first line "# description", then packages
# ("aur:<name>" for AUR). Each machine's answers live in hosts/<host>/optional.txt:
# "<group>" = installed here, "!<group>" = declined (not asked again).
OPTDIR=$DOT/packages/optional
opt_groups() { [ -d "$OPTDIR" ] && (cd "$OPTDIR" && for f in *.txt; do [ -e "$f" ] && echo "${f%.txt}"; done) || true; }
opt_desc() { sed -n '1s/^# *//p' "$OPTDIR/$1.txt"; }
opt_chosen() { grep -v -E '^\s*(#|$|!)' "$HOSTDIR/optional.txt" 2>/dev/null | awk '{print $1}' || true; }
opt_state() { # yes | no | (empty = not asked yet)
  grep -qx "$1" "$HOSTDIR/optional.txt" 2>/dev/null && { echo yes; return; }
  grep -qx "!$1" "$HOSTDIR/optional.txt" 2>/dev/null && echo no || true
}
opt_record() { # opt_record <group> yes|no
  local f=$HOSTDIR/optional.txt
  [ -f "$f" ] || printf '# %s — optional package groups (dot optional). "!name" = declined.\n' "$HOST" >"$f"
  sed -i -e "/^!\?$1\$/d" "$f"
  [ "$2" = yes ] && echo "$1" >>"$f" || echo "!$1" >>"$f"
}
# packages of the chosen groups: repo ones, or AUR ones with "aur"
opt_pkgs() {
  local g
  for g in $(opt_chosen); do
    [ -f "$OPTDIR/$g.txt" ] || continue
    if [ "${1:-}" = aur ]; then pkglist "$OPTDIR/$g.txt" | sed -n 's/^aur://p'
    else pkglist "$OPTDIR/$g.txt" | grep -v '^aur:'; fi
  done
}

# dot optional            ask about groups this machine hasn't answered yet
# dot optional --ask      ask about every group again
# dot optional <group>…   install these groups
# dot optional --list     show groups and this machine's answers
cmd_optional() {
  [ -d "$HOSTDIR" ] || die "no hosts/$HOST (dot new-host)"
  local g a st ask_all=0 picked=()
  case ${1:-} in
    --list | -l)
      for g in $(opt_groups); do
        st=$(opt_state "$g"); printf '  %-16s %-10s %s\n' "$g" "${st:-not asked}" "$(opt_desc "$g")"
      done
      return ;;
    --ask) ask_all=1; shift ;;
  esac
  if [ $# -gt 0 ]; then
    for g in "$@"; do [ -f "$OPTDIR/$g.txt" ] || die "no such group: $g (dot optional --list)"; picked+=("$g"); done
  else
    for g in $(opt_groups); do
      st=$(opt_state "$g")
      [ $ask_all -eq 0 ] && [ -n "$st" ] && continue
      read -r -p ":: optional: $(opt_desc "$g") — install? [y/N] " a
      if [[ ${a,,} == y* ]]; then picked+=("$g"); else opt_record "$g" no; fi
    done
  fi
  [ ${#picked[@]} -gt 0 ] || { say "no optional groups to install"; return 0; }
  for g in "${picked[@]}"; do opt_record "$g" yes; done
  cmd_install_packages
}

cmd_packages() {
  [ -d "$HOSTDIR" ] || die "no hosts/$HOST (dot new-host)"
  local common aur
  common=$( (pkglist "$DOT/packages/common.txt"; opt_pkgs) | sort -u)
  aur=$( (pkglist "$DOT/packages/aur.txt"; opt_pkgs aur) | sort -u)
  {
    echo "# $HOST — explicitly installed repo packages beyond packages/common.txt and optional groups."
    echo "# Snapshot from \`dot packages\` ($(date +%F)); edit freely."
    comm -23 <(pacman -Qqen | sort -u) <(echo "$common")
  } >"$HOSTDIR/packages.txt"
  {
    echo "# $HOST — AUR packages beyond packages/aur.txt (snapshot $(date +%F))."
    comm -23 <(pacman -Qqem | sort -u) <(echo "$aur")
  } >"$HOSTDIR/aur.txt"
  say "updated hosts/$HOST/packages.txt and aur.txt"
  git -C "$DOT" --no-pager diff --stat -- "hosts/$HOST"
}

cmd_install_packages() {
  local repo aurs avail missing
  repo=$( (pkglist "$DOT/packages/common.txt"; pkglist "$HOSTDIR/packages.txt"; opt_pkgs) | sort -u)
  avail=$(pacman -Slq | sort -u)
  missing=$(comm -23 <(echo "$repo") <(echo "$avail"))
  [ -z "$missing" ] || warn "not in the repos, skipped: $(echo $missing)"
  say "installing repo packages (sudo)"
  # shellcheck disable=SC2046
  sudo pacman -S --needed $(comm -12 <(echo "$repo") <(echo "$avail"))
  aurs=$( (pkglist "$DOT/packages/aur.txt"; pkglist "$HOSTDIR/aur.txt"; opt_pkgs aur) | sort -u)
  if [ -n "$aurs" ]; then
    say "AUR packages: $(echo $aurs)"
    if command -v paru >/dev/null; then
      # shellcheck disable=SC2086
      paru -S --needed $aurs
    else
      warn "paru not installed — install these yourself: $(echo $aurs)"
    fi
  fi
}

cmd_install() {
  [ -d "$HOSTDIR" ] || { warn "no hosts/$HOST yet"; read -r -p ":: create it from the template now? [Y/n] " a; [[ ${a,,} == n* ]] || cmd_new_host "$HOST"; }
  if [ -n "$(opt_groups)" ]; then
    say "optional apps (answers are saved in hosts/$HOST/optional.txt)"
    cmd_optional_ask_only
  fi
  cmd_install_packages
  say "downloading assets (wallpapers, cursors, mpv scripts, apps)"
  "$DOT/scripts/fetch-assets"
  cmd_link
  say "system files (sudo): keyring unlock at login, DDC/CI, Chrome theme policy, greeter"
  sudo "$DOT/system/setup"
  say "user services"
  systemctl --user daemon-reload
  systemctl --user enable gnome-keyring-daemon.socket hokum.service 2>/dev/null || true
  systemctl --user disable hyprpolkitagent.service 2>/dev/null || true
  fc-cache -f >/dev/null
  if [ -x "$HOSTDIR/setup" ]; then
    say "hosts/$HOST/setup"
    "$HOSTDIR/setup"
  fi
  if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    say "applying theme"
    ~/.config/quickshell/scripts/mocha-theme apply || true
    ~/.config/quickshell/scripts/mocha-theme thumbs >/dev/null || true
  fi
  say "done. Log out and back in (the greeter unlocks the keyring and starts Hyprland)."
}

# record answers for unasked groups without installing (install happens right after)
cmd_optional_ask_only() {
  local g a
  for g in $(opt_groups); do
    [ -n "$(opt_state "$g")" ] && continue
    read -r -p ":: optional: $(opt_desc "$g") — install? [y/N] " a
    if [[ ${a,,} == y* ]]; then opt_record "$g" yes; else opt_record "$g" no; fi
  done
}

cmd_new_host() {
  local name=${1:-$HOST}
  [ -e "$DOT/hosts/$name" ] && die "hosts/$name already exists"
  cp -r "$DOT/hosts/_template" "$DOT/hosts/$name"
  sed -i "s/HOSTNAME/$name/g" "$DOT/hosts/$name/README.md" "$DOT/hosts/$name/home/.config/hypr/host.lua"
  say "created hosts/$name — edit its host.lua (monitors: hyprctl monitors) and host.json, then: dot link"
}

# dot add [--host] <path>… — move files into the repo and link them back.
#   common package = first directory under ~/.config (or the file name for dotfiles in ~)
cmd_add() {
  local to_host=0 f rel pkg dest
  [ "${1:-}" = "--host" ] && { to_host=1; shift; }
  [ $# -gt 0 ] || die "usage: dot add [--host] <path>…"
  for f in "$@"; do
    f=$(realpath -s "$f")
    [ -f "$f" ] && [ ! -L "$f" ] || die "$f: not a regular file"
    rel=${f#"$HOME"/}
    [ "$rel" != "$f" ] || die "$f is outside your home"
    if [ $to_host -eq 1 ]; then
      dest=$HOSTDIR/home/$rel
    else
      case $rel in
        .config/*/*) pkg=$(echo "$rel" | cut -d/ -f2) ;;
        .local/share/*/*) pkg=$(echo "$rel" | cut -d/ -f3) ;;
        *) pkg=$(basename "$rel" | sed 's/^\.//; s/rc$//; s/\..*$//') ;;
      esac
      dest=$DOT/common/$pkg/$rel
    fi
    mkdir -p "$(dirname "$dest")"
    mv "$f" "$dest"
    echo "   ~/$rel → ${dest#"$DOT"/}"
  done
  cmd_link >/dev/null
}

cmd_help() {
  cat <<EOF
dot — $DOT on $HOST

  dot install          first-time setup: packages, assets, links, system files, services
  dot link             (re)link everything for this machine (common/* + hosts/$HOST)
  dot unlink           remove the links (repo files stay)
  dot status           git status + links that are missing or were replaced by an app
  dot diff [--stat] [path…]  tracked shared/host changes; ignores untracked files
  dot save [message]   commit tracked shared/host edits, rebase and push
  dot save --allow-staged MSG  also publish explicitly staged other-host/maintenance files
  dot pull             pull without autostash; new links require explicit dot link
  dot add [--host] F…  move file(s) into the repo (common, or this host with --host) and link
  dot packages         snapshot this machine's extra packages into hosts/$HOST
  dot optional [grp…]  optional apps: ask about new groups, or install the named ones
                       (--list shows them, --ask asks about all of them again)
  dot new-host [name]  start hosts/<name> from hosts/_template
  dot cd               print the repo path (cd "\$(dot cd)")
EOF
}

case ${1:-help} in
  install) cmd_install ;;
  link) cmd_link ;;
  unlink) cmd_unlink ;;
  status | st) cmd_status ;;
  diff | d) shift; cmd_diff "$@" ;;
  save) shift; cmd_save "$@" ;;
  pull | sync) cmd_pull ;;
  add) shift; cmd_add "$@" ;;
  packages | pkgs) cmd_packages ;;
  install-packages) cmd_install_packages ;;
  optional | opt) shift; cmd_optional "$@" ;;
  new-host) shift; cmd_new_host "${1:-}" ;;
  cd | path) echo "$DOT" ;;
  help | -h | --help) cmd_help ;;
  *) cmd_help; exit 1 ;;
esac
