#!/usr/bin/env bash
# husain-pc only. Run by `dot install`; idempotent, safe to re-run by hand.
set -euo pipefail
say() { printf '\033[1;35m::\033[0m %s\n' "$*"; }

# VBAN: let VoiceMeeter on the Windows box reach PipeWire's receiver
# (home/.config/pipewire/pipewire.conf.d/vban.conf). ufw drops inbound by
# default, and the Windows box's address changes (.146 before, .160 now), so the
# whole LAN is allowed rather than one sender. ufw skips the rule if it exists.
if command -v ufw >/dev/null; then
  say "ufw: allow VBAN (UDP 6980) from the LAN"
  sudo ufw allow from 192.168.1.0/24 to any port 6980 proto udp comment 'VBAN from VoiceMeeter'
fi
