#!/usr/bin/env bash
# Downloads things that don't belong in git (big, or updated upstream). Each step
# is skipped when already present; pass --force to fetch again.
#   wallpapers   ~/Pictures/Wallpapers/catppuccin-mocha  (orangci/walls-catppuccin-mocha)
#   cursors      ~/.local/share/icons/catppuccin-mocha-dark-cursors (catppuccin/cursors)
#   mpv          uosc, thumbfast, Anime4K shaders into ~/.config/mpv
#   t3code       T3 Code nightly AppImage → ~/.local/opt/t3code (self-updating)
#   zed          Zed's official installer (~/.local/zed.app, self-updating)
#   mise         `mise install` for the tools in ~/.config/mise/config.toml
set -euo pipefail
FORCE=0; [ "${1:-}" = "--force" ] && FORCE=1
say() { printf '\033[1;35m::\033[0m %s\n' "$*"; }
have() { [ $FORCE -eq 0 ] && [ -e "$1" ]; }
TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
get() { curl -fsSL --retry 3 -o "$2" "$1"; }

W=~/Pictures/Wallpapers/catppuccin-mocha
if [ -d "$W/.git" ]; then
  say "wallpapers: updating"; git -C "$W" pull -q --ff-only || true
else
  say "wallpapers"; mkdir -p "$(dirname "$W")"
  git clone -q --depth 1 https://github.com/orangci/walls-catppuccin-mocha.git "$W"
fi

C=~/.local/share/icons/catppuccin-mocha-dark-cursors
if ! have "$C"; then
  say "cursors"; mkdir -p ~/.local/share/icons
  get https://github.com/catppuccin/cursors/releases/latest/download/catppuccin-mocha-dark-cursors.zip "$TMP/c.zip"
  rm -rf "$C"; unzip -qo "$TMP/c.zip" -d ~/.local/share/icons/
fi

M=~/.config/mpv
if ! have "$M/scripts/uosc"; then
  say "mpv: uosc"; mkdir -p "$M"
  get https://github.com/tomasklaen/uosc/releases/latest/download/uosc.zip "$TMP/uosc.zip"
  # only scripts/ and fonts/ — uosc.conf is written by mocha-theme
  unzip -qo "$TMP/uosc.zip" 'scripts/*' 'fonts/*' -d "$M"
fi
if ! have "$M/scripts/thumbfast.lua"; then
  say "mpv: thumbfast"; mkdir -p "$M/scripts"
  get https://raw.githubusercontent.com/po5/thumbfast/master/thumbfast.lua "$M/scripts/thumbfast.lua"
fi
if ! have "$M/shaders/Anime4K_Clamp_Highlights.glsl"; then
  say "mpv: Anime4K shaders"; mkdir -p "$M/shaders"
  get https://github.com/bloc97/Anime4K/releases/download/v4.0.1/Anime4K_v4.0.zip "$TMP/a4k.zip"
  unzip -qjo "$TMP/a4k.zip" '*.glsl' -d "$M/shaders"
fi

T=~/.local/opt/t3code/T3-Code.AppImage
if ! have "$T"; then
  say "T3 Code (nightly AppImage)"; mkdir -p "$(dirname "$T")"
  tag=$(curl -fsSL 'https://api.github.com/repos/pingdotgg/t3code/releases?per_page=10' |
    jq -r '[.[] | select(.prerelease and (.tag_name | test("nightly")))][0].tag_name')
  file=$(curl -fsSL "https://github.com/pingdotgg/t3code/releases/download/$tag/nightly-linux.yml" |
    sed -n 's/^path: *//p' | head -1)
  get "https://github.com/pingdotgg/t3code/releases/download/$tag/$file" "$T"
  chmod +x "$T"
fi

if ! have ~/.local/zed.app; then
  say "Zed (official installer)"
  curl -fsSL https://zed.dev/install.sh | sh
fi

if command -v mise >/dev/null || [ -x ~/.local/bin/mise ]; then
  say "mise tools"; "$(command -v mise || echo ~/.local/bin/mise)" install -y || true
else
  say "mise (official installer)"; curl -fsSL https://mise.run | sh
  ~/.local/bin/mise install -y || true
fi
