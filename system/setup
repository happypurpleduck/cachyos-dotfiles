#!/usr/bin/env bash
# System files for this dotfiles setup. Idempotent; run via sudo from your account:
#     sudo ~/cachyos-dotfiles/system/setup
set -euo pipefail
[ "$(id -u)" -eq 0 ] || { echo "run with sudo"; exit 1; }
USER_NAME=${SUDO_USER:?run via sudo from your user account}
USER_HOME=$(getent passwd "$USER_NAME" | cut -d: -f6)
say() { printf '\033[1;35m::\033[0m %s\n' "$*"; }

# Keyring: the login password unlocks gnome-keyring, so Electron apps (T3 Code,
# Discord, VS Code…) and Chrome can store secrets. Apps also need
# --password-store=gnome-libsecret on Hyprland (see common/electron).
PAM=/etc/pam.d/greetd
if [ -f "$PAM" ] && ! grep -q pam_gnome_keyring "$PAM"; then
  say "gnome-keyring unlock at login ($PAM)"
  sed -i '/^auth.*include.*system-local-login/a auth       optional     pam_gnome_keyring.so' "$PAM"
  sed -i '/^session.*include.*system-local-login/a session    optional     pam_gnome_keyring.so auto_start' "$PAM"
fi

# DDC/CI: monitor brightness over the cable (control center slider)
if [ ! -f /etc/modules-load.d/i2c-dev.conf ]; then
  say "DDC/CI (i2c-dev)"
  echo i2c-dev >/etc/modules-load.d/i2c-dev.conf
  modprobe i2c-dev || true
fi

# Chrome/Chromium follow the accent: a managed policy file owned by you, so
# mocha-theme can rewrite it without sudo
for d in /etc/opt/chrome/policies/managed /etc/chromium/policies/managed; do
  f=$d/mocha-theme.json
  if [ ! -f "$f" ]; then
    mkdir -p "$d"
    echo '{ "BrowserThemeColor": "#cba6f7" }' >"$f"
  fi
  chown "$USER_NAME" "$f"
done

# Login screen: the Mocha greeter (greetd → cage → Quickshell)
if [ -x "$USER_HOME/.config/quickshell/scripts/install-greeter" ]; then
  if grep -q mocha-greeter /etc/greetd/config.toml 2>/dev/null; then
    say "updating the Mocha greeter"
    "$USER_HOME/.config/quickshell/scripts/install-greeter" >/dev/null
  else
    read -r -p ":: install the Mocha login greeter (replaces the current login screen)? [y/N] " a
    [[ ${a,,} == y* ]] && "$USER_HOME/.config/quickshell/scripts/install-greeter"
  fi
fi
say "system files done"
