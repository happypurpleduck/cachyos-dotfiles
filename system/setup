#!/usr/bin/env bash
# Limited system integration for CachyOS. Preview by default; apply explicitly.
# Greeter/display-manager switching is NOT part of this script.
set -euo pipefail

case "${1:---dry-run}" in
  --dry-run) MODE=preview ;;
  --apply) MODE=apply ;;
  *) echo "usage: system/setup [--dry-run|--apply]" >&2; exit 2 ;;
esac
[ "$#" -le 1 ] || { echo "unexpected setup arguments" >&2; exit 2; }

PAM=/etc/pam.d/greetd
DDC=/etc/modules-load.d/i2c-dev.conf
say() { printf "\033[1;35m::\033[0m %s\n" "$*"; }

if [ "$MODE" = preview ]; then
  say "read-only system setup preview"
  if [ -f "$PAM" ] && ! grep -q pam_gnome_keyring "$PAM"; then
    echo "   would add optional gnome-keyring PAM hooks to $PAM (with backup)"
  else
    echo "   PAM: existing hooks or greetd not present; no change"
  fi
  if [ ! -e "$DDC" ]; then echo "   would create $DDC (i2c-dev)";
  else echo "   DDC: already configured"; fi
  echo "   no greeter/display-manager changes"
  echo "   no Chrome/Chromium policy ownership changes"
  echo "   to apply these limited changes: dot system-setup --apply"
  exit 0
fi

[ "$(id -u)" -eq 0 ] || { echo "--apply requires sudo" >&2; exit 1; }
USER_NAME=${SUDO_USER:?run via sudo from your user account}
USER_HOME=$(getent passwd "$USER_NAME" | cut -d: -f6)
[ -n "$USER_HOME" ] && [ -d "$USER_HOME" ] || { echo "invalid sudo user home" >&2; exit 1; }

# Back up the original complete PAM file, then atomically promote edits.
# Do not write a partial PAM file if the expected CachyOS include lines are absent.
if [ -f "$PAM" ] && ! grep -q pam_gnome_keyring "$PAM"; then
  grep -Eq "^auth[[:space:]].*include[[:space:]]+system-local-login" "$PAM" || { echo "PAM auth include not found; refusing" >&2; exit 1; }
  grep -Eq "^session[[:space:]].*include[[:space:]]+system-local-login" "$PAM" || { echo "PAM session include not found; refusing" >&2; exit 1; }
  backup="$USER_HOME/.local/state/dotfiles-backup/system/$(date +%Y%m%d-%H%M%S)-$$"
  mkdir -p -- "$backup"
  cp -a -- "$PAM" "$backup/greetd-pam"
  temp=$(mktemp /etc/pam.d/.greetd.mocha.XXXXXXXX)
  trap 'rm -f -- "$temp"' EXIT
  cp -- "$PAM" "$temp"
  sed -i '/^auth.*include.*system-local-login/a auth       optional     pam_gnome_keyring.so' "$temp"
  sed -i '/^session.*include.*system-local-login/a session    optional     pam_gnome_keyring.so auto_start' "$temp"
  chown --reference="$PAM" "$temp"
  chmod --reference="$PAM" "$temp"
  mv -- "$temp" "$PAM"
  trap - EXIT
  say "updated PAM; original preserved at $backup/greetd-pam"
  echo "   TTY recovery: sudo cp -a -- '$backup/greetd-pam' '$PAM'"
fi

# Module-load config is additive and only created when not already present.
if [ ! -e "$DDC" ]; then
  printf 'i2c-dev\n' >"$DDC"
  chmod 0644 "$DDC"
  modprobe i2c-dev || echo "!! could not load i2c-dev now; reboot may be needed" >&2
  say "added i2c-dev module-load rule"
fi

# Do not chown /etc/browser policies to a regular user or change an existing
# policy, and never install/replace a greeter from this generic setup script.
say "system setup complete; greeter and browser policy left unchanged"
